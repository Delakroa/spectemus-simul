# Copy to a protected file outside git, for example /opt/spectemus-simul/.env.
# Values below are placeholders only. Generate real LiveKit and Redis values with
# the official LiveKit production generator; never reuse its sample output.

WT_STAGING_APP_DOMAIN=app.staging.example.com
WT_STAGING_RTC_DOMAIN=rtc.staging.example.com
WT_STAGING_TURN_DOMAIN=turn.staging.example.com

# Must match the Redis password generated for the LiveKit stack. Spectemus Simul
# uses Redis database 1; LiveKit keeps its own state in database 0.
LIVEKIT_REDIS_PASSWORD=replace-with-a-real-secret
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
FEEDBACK_ADMIN_TOKEN=replace-with-a-separate-long-random-secret

FEEDBACK_RETENTION=30d
FEEDBACK_EXPORT_LIMIT=200
ROOM_TTL=4h
ROOM_CLEANUP_GRACE=5m
LIVEKIT_TOKEN_TTL=10m

# Only for the opt-in public.compose.yaml overlay. Keep real values outside git.
# PostgreSQL must already exist and be reachable from the backend container.
PUBLIC_ACCESS_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/spectemus
PUBLIC_ACCESS_JDBC_USERNAME=replace-with-db-user
PUBLIC_ACCESS_JDBC_PASSWORD=replace-with-db-password
PUBLIC_ACCESS_IDENTITY_PEPPER=replace-with-a-long-random-pepper
PUBLIC_ACCESS_EMAIL_HOST=replace-with-smtp-host
PUBLIC_ACCESS_EMAIL_PORT=587
PUBLIC_ACCESS_EMAIL_USERNAME=replace-with-smtp-user
PUBLIC_ACCESS_EMAIL_PASSWORD=replace-with-smtp-password
PUBLIC_ACCESS_EMAIL_FROM=replace-with-verified-sender@example.com
# Use credentials issued for the public LiveKit server, not LAN devkey/devsecret.
PUBLIC_LIVEKIT_API_KEY=replace-with-public-livekit-key
PUBLIC_LIVEKIT_API_SECRET=replace-with-public-livekit-secret
