# Только для локальной разработки. Не использовать эти значения в production.

APP_PORT=8088
BACKEND_PORT=8080
GATEWAY_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50100
LIVEKIT_BIND_ADDRESS=127.0.0.1
LIVEKIT_NODE_IP=127.0.0.1

POSTGRES_DB=spectemus_simul
POSTGRES_USER=spectemus_simul
POSTGRES_PASSWORD=spectemus_simul_dev_only

REDIS_PASSWORD=spectemus_simul_redis_dev_only

# Internet mode remains disabled in local Docker. Do not put real SMTP or
# production database credentials in this file.
PUBLIC_ACCESS_ENABLED=false
# Desktop↔public account binding stays fail-closed with public access.
PUBLIC_DEVICE_BINDING_ENABLED=false
PUBLIC_DEVICE_BINDING_VERIFICATION_ORIGIN=
PUBLIC_DEVICE_BINDING_TTL=10m
PUBLIC_DEVICE_SESSION_TTL=14d
PUBLIC_DEVICE_POLL_INTERVAL=5s
ROOM_TTL=4h
SESSION_COOKIE_SECURE=false

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
LIVEKIT_URL=ws://127.0.0.1:7880
PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880

# SPS-720/721 public LiveKit (backend). Keep disabled locally; do not point at
# LAN/default credentials. Frontend build still uses PUBLIC_LIVEKIT_URL above.
PUBLIC_LIVEKIT_ENABLED=false
PUBLIC_LIVEKIT_RTC_URL=
PUBLIC_LIVEKIT_API_URL=
PUBLIC_LIVEKIT_API_KEY=
PUBLIC_LIVEKIT_API_SECRET=
PUBLIC_LIVEKIT_TOKEN_TTL=5m
PUBLIC_LIVEKIT_ADMIN_TOKEN_TTL=1m
PUBLIC_LIVEKIT_ADMIN_TIMEOUT=3s

# WT-605 feedback operations. Operator endpoints (list/export/triage) stay disabled
# while the token is empty; set a real secret on beta to enable them.
FEEDBACK_ADMIN_TOKEN=
FEEDBACK_RETENTION=30d

# WT-606 gateway CSP connect-src (default "'self' ws: wss:" when unset). Narrow in
# production to the fixed beta host(s), e.g.:
# WT_CSP_CONNECT_SRC='self' wss://<livekit-public-host>
# Rate limiting (WT-606) is on by default; RATE_LIMIT_* overrides live in application.yml.
